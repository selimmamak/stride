{
  "expo": {
    "name": "Stride",
    "slug": "stride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.selimmamak.stride",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withStrideHealth",
      "expo-router",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Stride uses your precise location to record distance and routes during your runs. Your history stays on this phone.",
          "locationAlwaysAndWhenInUsePermission": "Stride records your run while your screen is locked. Location recording stops when you finish or pause your run.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080C0F",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font"
    ],
    "scheme": "stride"
  }
}
